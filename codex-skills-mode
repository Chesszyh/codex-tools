#!/usr/bin/env python3
"""Switch Codex between the existing user-skill config and a minimal mode."""

from __future__ import annotations

import json
import os
import shutil
import sys
import tempfile
import tomllib
from datetime import datetime, timezone
from pathlib import Path


SKILLS_ROOT = Path(
    os.environ.get("CODEX_SKILLS_MODE_ROOT", "~/.agents/skills")
).expanduser().absolute()
CONFIG_PATH = Path(
    os.environ.get("CODEX_SKILLS_MODE_CONFIG", "~/.codex/config.toml")
).expanduser().absolute()
STATE_DIR = Path(
    os.environ.get("CODEX_SKILLS_MODE_STATE_DIR", "~/.codex/skill-mode-switcher")
).expanduser().absolute()
STATE_PATH = STATE_DIR / "state.json"


def is_table_header(line: str) -> bool:
    stripped = line.strip()
    return stripped.startswith("[") and "]" in stripped


def parse_skill_block(block: str) -> dict[str, object] | None:
    try:
        entries = tomllib.loads(block)["skills"]["config"]
        if len(entries) == 1 and isinstance(entries[0], dict):
            return entries[0]
    except (KeyError, TypeError, tomllib.TOMLDecodeError):
        pass
    return None


def path_is_user_skill(value: object) -> bool:
    if not isinstance(value, str):
        return False
    candidate = Path(value).expanduser().absolute()
    try:
        return os.path.commonpath((str(SKILLS_ROOT), str(candidate))) == str(SKILLS_ROOT)
    except ValueError:
        return False


def extract_skill_blocks(text: str) -> list[str]:
    lines = text.splitlines(keepends=True)
    blocks: list[str] = []
    index = 0
    while index < len(lines):
        if lines[index].strip() != "[[skills.config]]":
            index += 1
            continue
        end = index + 1
        while end < len(lines) and not is_table_header(lines[end]):
            end += 1
        blocks.append("".join(lines[index:end]))
        index = end
    return blocks


def rewrite_skill_blocks(
    text: str, replacement: list[str], *, remove_all: bool = False
) -> tuple[str, list[str]]:
    lines = text.splitlines(keepends=True)
    output: list[str] = []
    removed: list[str] = []
    insertion_index: int | None = None
    index = 0

    while index < len(lines):
        if lines[index].strip() != "[[skills.config]]":
            output.append(lines[index])
            index += 1
            continue

        end = index + 1
        while end < len(lines) and not is_table_header(lines[end]):
            end += 1
        block = "".join(lines[index:end])
        entry = parse_skill_block(block)

        if remove_all or (
            entry is not None and path_is_user_skill(entry.get("path"))
        ):
            if insertion_index is None:
                insertion_index = len(output)
            removed.append(block)
        else:
            output.append(block)
        index = end

    if insertion_index is None:
        insertion_index = len(output)
        if output and not output[-1].endswith("\n\n"):
            output.append("\n")
            insertion_index += 1

    output[insertion_index:insertion_index] = replacement
    rewritten = "".join(output)
    tomllib.loads(rewritten)
    return rewritten, removed


def discover_skills() -> list[Path]:
    found: list[Path] = []
    visited: set[str] = set()

    for current, directories, files in os.walk(SKILLS_ROOT, followlinks=True):
        real_current = os.path.realpath(current)
        if real_current in visited:
            directories[:] = []
            continue
        visited.add(real_current)

        if "SKILL.md" in files:
            found.append(Path(current) / "SKILL.md")

        kept: list[str] = []
        for directory in directories:
            real_directory = os.path.realpath(os.path.join(current, directory))
            if real_directory not in visited:
                kept.append(directory)
        directories[:] = kept

    return sorted(found, key=lambda path: str(path).casefold())


def disabled_blocks(paths: list[Path]) -> list[str]:
    return [
        "[[skills.config]]\n"
        + f"path = {json.dumps(str(path), ensure_ascii=False)}\n"
        + "enabled = false\n\n"
        for path in paths
    ]


def read_state() -> dict[str, object]:
    if not STATE_PATH.exists():
        return {"mode": "current", "original_blocks": []}
    try:
        state = json.loads(STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise RuntimeError(f"无法读取状态文件：{STATE_PATH}: {error}") from error
    if not isinstance(state, dict):
        raise RuntimeError(f"状态文件格式错误：{STATE_PATH}")
    return state


def atomic_write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
        if path.exists():
            shutil.copymode(path, temporary)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def write_state(state: dict[str, object]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    atomic_write(STATE_PATH, json.dumps(state, ensure_ascii=False, indent=2) + "\n")


def use_minimal() -> None:
    if not CONFIG_PATH.exists():
        raise RuntimeError(f"找不到 Codex 配置：{CONFIG_PATH}")
    if not SKILLS_ROOT.is_dir():
        raise RuntimeError(f"找不到用户 skills 目录：{SKILLS_ROOT}")

    paths = discover_skills()
    state = read_state()
    current_text = CONFIG_PATH.read_text(encoding="utf-8")
    original_blocks = extract_skill_blocks(current_text)
    rewritten, _ = rewrite_skill_blocks(
        current_text, disabled_blocks(paths)
    )

    if state.get("mode") != "minimal":
        state = {
            "mode": "minimal",
            "captured_at": datetime.now(timezone.utc).isoformat(),
            "skills_root": str(SKILLS_ROOT),
            "original_blocks": original_blocks,
        }

    atomic_write(CONFIG_PATH, rewritten)
    write_state(state)
    print(f"已切换到极简模式：禁用 {len(paths)} 个 ~/.agents/skills 技能。")
    print("项目内 .agents/skills、Codex 内建技能和插件技能未修改。")
    print("请在 Codex App 中新建任务；如果列表未刷新，请重启 App。")


def use_current() -> None:
    if not CONFIG_PATH.exists():
        raise RuntimeError(f"找不到 Codex 配置：{CONFIG_PATH}")
    state = read_state()
    if state.get("mode") != "minimal":
        print("当前已经是原配置模式，无需恢复。")
        return

    original_blocks = state.get("original_blocks")
    if not isinstance(original_blocks, list) or not all(
        isinstance(block, str) for block in original_blocks
    ):
        raise RuntimeError(f"状态文件缺少可恢复的 skill 配置：{STATE_PATH}")

    current_text = CONFIG_PATH.read_text(encoding="utf-8")
    rewritten, _ = rewrite_skill_blocks(
        current_text, original_blocks, remove_all=True
    )
    atomic_write(CONFIG_PATH, rewritten)
    state["mode"] = "current"
    state["restored_at"] = datetime.now(timezone.utc).isoformat()
    write_state(state)
    print(f"已恢复切换前的配置：还原 {len(original_blocks)} 个 skill 配置块。")
    print("请在 Codex App 中新建任务；如果列表未刷新，请重启 App。")


def show_status() -> None:
    state = read_state()
    mode = "极简模式" if state.get("mode") == "minimal" else "原配置模式"
    count = len(discover_skills()) if SKILLS_ROOT.is_dir() else 0
    print(f"当前模式：{mode}")
    print(f"发现用户 skills：{count}")
    print(f"Skills 目录：{SKILLS_ROOT}")
    print(f"Codex 配置：{CONFIG_PATH}")


def interactive_choice() -> str:
    print("Codex Skills 模式")
    print("  1. 当前配置")
    print("  2. 极简模式（禁用全部 ~/.agents/skills）")
    return input("请选择 [1/2]：").strip()


def main() -> int:
    command = sys.argv[1].lower() if len(sys.argv) > 1 else interactive_choice()
    if command in {"1", "current", "restore"}:
        use_current()
    elif command in {"2", "minimal", "pi"}:
        use_minimal()
    elif command in {"status", "show"}:
        show_status()
    elif command in {"-h", "--help", "help"}:
        print("用法：codex-skills-mode [1|2|current|minimal|status]")
    else:
        print(f"未知选项：{command}", file=sys.stderr)
        print("用法：codex-skills-mode [1|2|current|minimal|status]", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, tomllib.TOMLDecodeError) as error:
        print(f"错误：{error}", file=sys.stderr)
        raise SystemExit(1)
